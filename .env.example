# Copy to .env and fill in.
#
# Only the two NEXT_PUBLIC_ values are read by the application, and only those
# two belong in a hosting provider's environment settings. They are sent to the
# browser by design.
#
# Find them at: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------------------------------------------------------------------------
# CLI only. Never commit these, and never add them to Vercel or any other host.
# ---------------------------------------------------------------------------

# Your project's database password, used by `supabase link`.
SUPABASE_PROJECT_PASSWORD=

# A PERSONAL access token for your Supabase account - not a project credential.
# Anyone reproducing this needs to generate their own:
#   https://supabase.com/dashboard/account/tokens
# Required because `supabase login`'s browser flow fails in non-interactive
# shells with LegacyLoginMissingTokenError.
SUPABASE_ACCESS_TOKEN=
