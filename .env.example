# Copy to .env. As shipped, these point at the LOCAL Supabase stack, so
#
#   pnpm supabase start && pnpm supabase db reset && pnpm dev
#
# gives you a working app with both roles seeded - no account anywhere, no
# values to fill in, nothing requested from anyone.
#
# Both are fixed defaults of the Supabase CLI: identical on every machine,
# reachable only on localhost. That is why they are committed. Swap them for a
# project's own values to point at a hosted project instead - find those at
# https://supabase.com/dashboard/project/_/settings/api. These two are the only
# variables the application reads, and it sends both to the browser by design.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# ---------------------------------------------------------------------------
# CLI only, and only if you are linking a hosted project of your own - local
# development needs neither. Never commit these, and never add them to Vercel
# or any other host.
# ---------------------------------------------------------------------------

# Your project's database password, used by `supabase link`.
SUPABASE_PROJECT_PASSWORD=

# A PERSONAL access token for your Supabase account - not a project credential.
# Anyone reproducing this needs to generate their own:
#   https://supabase.com/dashboard/account/tokens
# Required because `supabase login`'s browser flow fails in non-interactive
# shells with LegacyLoginMissingTokenError.
SUPABASE_ACCESS_TOKEN=
